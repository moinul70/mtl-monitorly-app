<!DOCTYPE html>
<html lang="en">

<%- include('common-header') %>
<body>
    <div class="page">

        <header class="topbar">
            <div class="brand">
                <span class="brand-mark" aria-hidden="true">
                    <span class="brand-pulse"></span>
                </span>
                <a class="brand-name" href="/">Monitorly</a>
            </div>
           
        </header>

        <main>
            <section class="hero">
                <p class="eyebrow">Uptime, System &amp; response monitoring</p>
                <h1>Every server, one heartbeat away.</h1>
                <p class="hero-copy">Monitorly checks your servers around the clock and tells you the moment something
                    looks wrong.</p>
            </section>

        <%- include('system-metrics') %>

        </br>
            <section class="projects" id="projects_list" aria-label="Monitored projects">
                <!-- Existing projects are injected here by dashboard.js -->

                <a class="card-add addProjectBtn" href="#" id="projects_list_card">
                    <span class="card-add-icon" aria-hidden="true">+</span>
                    <span class="card-add-label">Add a project</span>
                </a>
            </section>
        </main>
          

        <div class="modal-overlay" id="projectModal">
            <div class="modal">
                <button type="button" class="modal-close" id="closeProjectModal" aria-label="Close">&times;</button>

                <p class="mb-4 text-sm text-slate-500">Enter the name of the server and base URL you want to monitor.</p>

                <p class="modal-error hidden" id="modalError"></p>

                <form id="addProjectForm">
                    <div class="form-group">
                        <label for="project_name">Project name</label>
                        <input type="text" id="project_name" name="project_name" placeholder="My Server" required
                            maxlength="100" autocomplete="off">
                    </div>
                    <div class="form-group">
                        <label for="project_base_url">Project base URL</label>
                        <input type="text" id="project_base_url" name="project_base_url" placeholder="https://my-server.com" required
                            maxlength="200" autocomplete="off">
                    </div>

                    <button type="submit" class="submit-btn" id="submitProjectBtn">
                        Add Project
                    </button>
                </form>
            </div>
        </div>

        <footer class="footer">
            <p>Monitorly checks in every <span class="refresh-time"></span> seconds. Made by <a class="underline underline-offset-2 hover:text-blue-600 transition-colors duration-200" href="https://github.com/moinul70">Moinul Tech Lab</a></p>
        </footer>

    </div>

    <script type="module" src="/js/dashboard.js"></script>
</body>

</html>
