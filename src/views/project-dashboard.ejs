<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitorly — Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="page">

        <header class="topbar">
            <div class="brand">
                <span class="brand-mark" aria-hidden="true">
                    <span class="brand-pulse"></span>
                </span>
                <span class="brand-name">Monitorly</span>
            </div>
            <a class="topbar-cta" href="/">&larr; All projects</a>
        </header>

        <main>
            <section class="dash-head">
                <div class="dash-head-top">
                    <span class="pulse-dot" id="project-dot" aria-hidden="true"></span>
                    <h1 class="dash-title" id="project-title">Loading&hellip;</h1>
                    <span class="status-pill" id="project-status">&mdash;</span>
                </div>
                <!-- <p class="dash-sub">
                    <span id="project-host">&mdash;</span>
                    <span class="dash-sub-sep">&middot;</span>
                    <span id="project-platform">&mdash;</span>
                </p> -->
            </section>

                 <!-- <%- include('system-metrics') %> -->
            <section class="api-section" aria-label="API metrics">
                <h2 class="section-title">API metrics</h2>

                <div class="critical-card" id="critical-card">
                    <span class="critical-label">Most critical endpoint</span>
                    <div class="critical-main">
                        <span class="method-badge" id="critical-method">&mdash;</span>
                        <span class="critical-path" id="critical-path">&mdash;</span>
                    </div>
                    <div class="metric-subrow">
                        <div class="metric-sub">
                            <span class="metric-sub-value" id="critical-error">&mdash;</span>
                            <span class="metric-sub-label">error rate</span>
                        </div>
                        <div class="metric-sub">
                            <span class="metric-sub-value" id="critical-p95">&mdash;</span>
                            <span class="metric-sub-label">p95 response</span>
                        </div>
                        <div class="metric-sub">
                            <span class="metric-sub-value" id="critical-rpm">&mdash;</span>
                            <span class="metric-sub-label">req/min</span>
                        </div>
                    </div>
                </div>

                <div class="api-table-wrap">
                    <table class="api-table">
                        <thead>
                            <tr>
                                <th>Endpoint</th>
                                <th>Avg</th>
                                <th>p95</th>
                                <th>Req/min</th>
                                <th>Errors</th>
                                <th>Memory</th>
                            </tr>
                        </thead>
                        <tbody id="api-table-body">
                            <tr><td colspan="6" class="api-table-loading">Loading endpoints&hellip;</td></tr>
                        </tbody>
                    </table>
                    <div id="load-more-container" class="load-more-container"></div>
                </div>
            </section>

            <p class="dash-footnote">
                Last updated <span id="last-updated">&mdash;</span> &middot; <span class="refresh-label">refreshing every</span> <span id="refresh-interval"></span>
            </p>
        </main>

    </div>
<!-- <script src="/js/metrics.js"></script> -->
    <script src="/js/project-dashboard.js"></script>
</body>
</html>
